# Copia este archivo como .env y completa los valores.
# En Vercel, estas variables se configuran en Project → Settings → Environment Variables.

# --- Base de datos (obligatoria) --------------------------------------------
# PostgreSQL: Neon (recomendado en Vercel), Supabase, Railway o uno local.
DATABASE_URL=postgres://usuario:clave@localhost:5432/solisracing

# --- Panel de administración -----------------------------------------------
# Usuario que se crea automáticamente la primera vez (si aún no hay ninguno).
ADMIN_EMAIL=tu-correo@gmail.com
ADMIN_PASSWORD=cambia-esta-clave
# Secreto para firmar las sesiones del panel. Genera uno con: openssl rand -base64 32
# (si lo dejas vacío, se genera uno automáticamente y se guarda en la base de datos)
AUTH_SECRET=

# --- Sitio -----------------------------------------------------------------
# URL pública, sin "/" al final (se usa en correos, sitemap y redes sociales).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Carga el catálogo inicial (productos de su catálogo de WhatsApp) cuando la base de datos no tiene productos.
SEED_DEMO_DATA=true

# --- Webpay Plus (Transbank) -----------------------------------------------
# integration = ambiente de pruebas de Transbank (tarjetas de prueba, sin cobros reales)
# production  = cobros reales (requiere WEBPAY_COMMERCE_CODE y WEBPAY_API_KEY)
# mock        = simulador local sin conexión a Transbank (solo desarrollo y pruebas)
WEBPAY_ENVIRONMENT=integration
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# --- Imágenes de productos -------------------------------------------------
# Token de Vercel Blob (Storage → Blob). Sin él, las fotos se guardan en ./uploads (solo local).
BLOB_READ_WRITE_TOKEN=

# --- Correos (opcional) ----------------------------------------------------
# Sin SMTP, los correos no se envían (se muestran en la consola del servidor).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Solis Racing Parts <ventas@tudominio.cl>"
